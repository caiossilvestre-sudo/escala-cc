# Copie este arquivo para ".env" e preencha com valores reais.
# O arquivo ".env" NUNCA deve ser commitado (já está no .gitignore).

# Local (SQLite, não precisa instalar nada):
DATABASE_URL=sqlite:///./dev.db
# Produção (Postgres — Supabase, Neon, Railway etc):
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Gere um valor forte com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=troque-este-valor-por-um-segredo-forte-e-aleatorio

FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=development

# Usados só na primeira vez que o servidor sobe com o banco vazio,
# para criar a conta do primeiro administrador.
FIRST_ADMIN_EMAIL=admin@suaempresa.com.br
FIRST_ADMIN_PASSWORD=escolha-uma-senha-forte-com-letras-e-numeros
